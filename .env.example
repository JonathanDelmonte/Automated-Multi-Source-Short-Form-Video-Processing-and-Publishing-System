# Cookies por plataforma (opcional, formato Netscape colado inteiro na variável).
# Cada uma tem o seu: o jar de uma não autentica na outra, e eles vão para
# arquivos separados para que dois jobs simultâneos não se sobrescrevam.
#
# YouTube: contorna a checagem de bot ("Sign in to confirm you're not a bot").
# YOUTUBE_COOKIES=...
#
# Twitch: só é necessário para VOD sub-only (exige conta inscrita no canal).
# Clip e VOD público baixam sem nada disto.
# TWITCH_COOKIES=...
#
# Google Drive: só para arquivo PRIVADO. Arquivo compartilhado por link
# ("qualquer pessoa com o link") baixa sem nada.
# GDRIVE_COOKIES=...

# Google OAuth (cloud/billing mode only). When logging in through a proxy whose
# Host header doesn't match a Google-registered URI (e.g. local dev via the Vite
# proxy), pin the callback explicitly:
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5175

# Local dev: show the full pipeline logs (yt-dlp/ffmpeg/debug) in the UI even
# when running in paid mode (BILLING_ENABLED). Cloud/prod leaves this unset.
# DEBUG_LOGS=true

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Whisper transcription model (main pipeline). "small" is better than "base" on
# non-English audio; "base" is faster. device/compute for GPU tuning.
# Prod GPU: WHISPER_MODEL=large-v3-turbo WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Transcription backend: whisper (default) | parakeet. Parakeet (NVIDIA
# parakeet-tdt-0.6b-v3 via onnx-asr, GPU image only) is ~2x faster than
# whisper-turbo-GPU and auto-falls-back to whisper on errors or languages
# outside its 25 European ones.
# TRANSCRIBE_BACKEND=whisper

# Concurrent GPU transcriptions (parakeet or whisper-on-cuda). Keep 1.
# ASR_GPU_CONCURRENCY=1

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# auto probes h264_nvenc once at startup and falls back to x264 if unusable.
# FFMPEG_ENCODER=x264

# Product analytics (optional, off by default). Both are read by the dashboard
# at BUILD time. Leave them unset and the frontend initialises no analytics and
# loads no third-party script. Set them to your own OpenPanel instance — and add
# your hostname to ANALYTICS_HOSTS in dashboard/index.html — to collect your own.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=your_openpanel_client_id

# Thumbnail Studio: creative text model (titles, concepts) and the image model.
# Not tied to GEMINI_MODEL on purpose: flash-lite is fine for closed choices,
# visibly worse at titles.
GEMINI_MODEL_THUMBNAIL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Moment picker on your own model instead of Gemini (self-host). Any
# OpenAI-compatible chat endpoint: Ollama, LM Studio, vLLM, llama.cpp,
# LocalAI, OpenRouter. With this set the Gemini key is optional; it is still
# used, if present, for the frame-based stages (layout picker, silent videos).
# Ollama needs a context above its 4096 default: OLLAMA_CONTEXT_LENGTH=16384.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# LLM_SCORE_BATCH=3
# LLM_TIMEOUT=600

# Hard daily ceiling for the per-GB paid proxy (UTC day, MB). Above it,
# DataImpulse is removed from every chain until midnight and the jobs that
# needed it fail with a clear error. 0 disables the cap. Default 500.
# PAID_PROXY_DAILY_MB=500

# ---------------------------------------------------------------------------
# Privacy, retention and access control (GDPR remediation, 4-sep-2026)
# ---------------------------------------------------------------------------

# Absolute base URL of the API as the internet reaches it. Already used for the
# absolute clip URLs in webhook payloads; now also required to build the
# unsubscribe link that goes in the out-of-minutes email. Without it that email
# falls back to "reply to unsubscribe".
# PUBLIC_API_URL=https://api.openshorts.app

# /videos and /thumbnails are authenticated endpoints, not static mounts.
# MEDIA_TOKEN_TTL_SECONDS: life of the per-user token the dashboard appends to
#   <video src> / <img src> URLs (default 43200 = 12 h).
# MEDIA_URL_TTL_SECONDS: life of the path-signed capability handed to consumers
#   that cannot send a header — webhook payloads and MCP tool results
#   (default 86400 = 24 h).
# MEDIA_TOKEN_TTL_SECONDS=43200
# MEDIA_URL_TTL_SECONDS=86400

# Retention for the two kinds of file that had none. Thumbnails and the frames
# sampled to make them are close-ups of a real person; the clock runs from the
# last download. Uploaded actor photos die with the job that used them.
# THUMBNAIL_RETENTION_SECONDS=86400
# ACTOR_UPLOAD_RETENTION_SECONDS=3600

# Per-IP rate limiting (rate_limit.py). "<max requests>/<window seconds>".
# Defaults: auth 30/600, process 60/3600, mcp 240/60. Set RATE_LIMIT_ENABLED=0
# to turn the whole thing off (self-host behind your own firewall).
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_AUTH=30/600
# RATE_LIMIT_PROCESS=60/3600
# RATE_LIMIT_MCP=240/60

# Which hop may declare the client's address in X-Forwarded-For. The Dockerfile
# defaults to the private Docker ranges; narrow it to Traefik's own address on
# the container network in production. NEVER "*": that lets any caller forge
# the IP the rate limiter and the rights declaration are keyed on.
# FORWARDED_ALLOW_IPS=10.0.1.7

# Strict-Transport-Security value sent on https responses from the API. Empty
# disables it. Do not add "preload" without understanding that it is one-way.
# HSTS_HEADER=max-age=31536000; includeSubDomains

# Encrypted PostgreSQL backups (ops/pg_backup.sh — installed and scheduled on
# the database host, not by the app). The privacy policy promises a deletion is
# gone from every copy within 30 days, which is only true while this runs.
# DATABASE_URL=postgres://user:pass@host:5432/openshorts
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_DEST=s3://openshorts-backups/pg
# BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# RETENTION_DAYS=30

# --- Quantos cortes por video -------------------------------------------
# O padrao NAO e fixo: o piso cresce com o material (3 janelas -> 3 cortes,
# 5 -> 4, 10+ -> 6) e o teto e min(12, janelas x 2). Ou seja, **nunca passa de
# 12** por padrao. Ver `clip_selection.clip_count_targets`, que explica a
# medicao por tras disso: em 429 jobs, quem recebia 1-3 cortes voltava no dia
# seguinte 0,4% das vezes; quem recebia 4-9, 16,1%.
#
# Estas duas variaveis sobrescrevem piso e teto sem rebuild -- basta
# `docker compose restart backend`. Uteis para fonte longa (uma live de uma
# hora tem material para muito mais de 12).
# CLIP_TARGET_MIN=6
# CLIP_TARGET_MAX=25

# --- Cascata de LLM gratuita (llm_cascade.py, ADR-004 e ADR-005) ----------
# O detector de momentos atravessa os provedores abaixo em ordem, e a ordem
# depende da duracao falada da fonte: fonte curta comeca no Groq (rapido,
# custo baixo em tokens), fonte longa comeca no Gemini (contexto de 1M e
# orcamento diario maior). Cada provedor entra na cascata so quando sua chave
# esta presente -- com nenhuma delas, o comportamento e o antigo.
#
# ATENCAO ao teto de tokens/dia do Groq: uma live de 4h consome de 60% a 75%
# dele num video so. O contador local fica em output/.llm_budget.json e zera
# a meia-noite UTC.
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...              tambem serve aos estagios por frames
#   Chaves novas do AI Studio comecam com AQ. em vez de AIza; as duas
#   valem. A AQ. funciona no endpoint nativo (que e o que main.py usa,
#   via SDK oficial) e da 401 em rota compativel-com-OpenAI -- entao nao
#   aponte LLM_BASE_URL para o endpoint OpenAI do Google com uma delas.
# CEREBRAS_API_KEY=csk-...
# OLLAMA_BASE_URL=http://localhost:11434/v1   opt-in: sem isso o Ollama
#                                             nao entra na cascata
#
# Modelo por provedor (cada um tem um default razoavel):
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_MODEL=llama-3.3-70b
# OLLAMA_MODEL=llama3.1:8b
#
# Ordem fixa, ignorando a duracao (lista de ids separada por virgula):
# LLM_CASCADE=groq,gemini,cerebras,ollama
#
# A partir de quantos segundos de fala a fonte conta como "longa":
# LLM_LONG_SOURCE_SECONDS=2400
#
# Tetos por provedor, para quando eles mudarem os limites sem aviso.
# 0 desliga a checagem daquele teto.
# LLM_GROQ_TPD=100000             tokens/dia
# LLM_GROQ_RPD=1000               chamadas/dia
# LLM_GROQ_RPM=30                 chamadas/minuto
# LLM_GROQ_CONTEXT=128000
# LLM_CEREBRAS_TPD=1000000
#
# Live da Twitch: duracao do bloco gravado por job, em minutos (padrao 15,
# teto 2h). Nao da para baixar o que ainda nao aconteceu, entao cada job grava
# um pedaco e corta esse pedaco -- uma live de 4h vira varios jobs curtos em vez
# de um job de 4 horas, e os cortes vao saindo enquanto ela acontece.
# TWITCH_LIVE_BLOCK_MINUTES=15

# Teto de um upload, em MB. Padrao 10240 (10 GB), que e o alvo do §4. O upload e
# gravado em disco em pedacos, nunca em memoria, entao o limite e o seu disco:
# ele convive com UPLOADS_MAX_GB (15) e OUTPUT_MAX_GB (25).
# MAX_FILE_SIZE_MB=10240

# Detector de pessoa (ADR-003). Padrao: MediaPipe, Apache 2.0.
#
# **Se voce corta gravacao de tela, screencast ou VOD com webcam no canto,
# provavelmente vai querer ligar o YOLO.** Ele nao serve so para enquadrar: os
# layouts INSET e SCREENCAST o usam para DETECTAR, e sem ele o INSET pode nao
# disparar e o SCREENCAST pode nao achar o apresentador (o rosto num recuadro
# de webcam 1080p e pequeno demais para o detector padrao). O log avisa uma vez
# por job quando isso acontece.
#
# Por que nasce desligado, entao: o YOLOv8 e **AGPL-3.0**, e o ADR-003 quis que
# o caminho padrao ficasse Apache 2.0 -- para uso pessoal, ligar nao tem
# problema nenhum; o que a licenca alcanca e distribuir ou servir a terceiros.
#   FACE_TRACKER=yolo
#
# Sem `--build-arg YOLO=1` na imagem, o primeiro clipe paga o download dos pesos.

# Pre-filtro heuristico (ADR-004). Nao ha nada a ligar: ele decide sozinho, e
# num video curto **nao faz nada** -- so atua quando as janelas de pontuacao
# nao caberiam no orcamento de tokens do dia. O corte e por orcamento, nunca
# por qualidade.
#
# Para mandar no numero de janelas a mao (diagnostico, ou um teto mais
# apertado que o calculado):
# PREFILTER_MAX_WINDOWS=120

# --- Banco de dados (Fase 0.5, secao 7 do Plano Tecnico) -------------------
# Sem DATABASE_URL, um SQLite em $DATA_DIR/cortes.db (default data/) -- zero
# operacao, que e
# o que um projeto self-hosted pessoal precisa. Fica FORA de output/, que e
# barrido pela limpeza por idade e pelo teto de tamanho. Para Postgres, aponte aqui e
# instale asyncpg; a forma sincrona e aceita e convertida para o driver async.
# DATA_DIR=data
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/cortes
#
# Criar ou atualizar o schema:
#   alembic upgrade head      # caminho de producao: sabe evoluir banco com dados
#   python db_seed.py         # cria o schema e semeia o tenant fixo
#
# Auth e a Fase 4. Ate la todo dado pertence ao tenant fixo do self-host,
# criado pelo seed com id 00000000-0000-0000-0000-000000000001.

# --- Camada de publicacao (Fase 3, secao 6; ADR-010) -----------------------
# O padrao e a **fila manual**, e ela nao e a versao capada: entrega o corte
# renderizado mais um arquivo de legenda pronta para colar, por plataforma. O
# que sobra e abrir o app e apertar publicar.
#
# Agregador (Upload-Post, Blotato e afins). Stub -- so faz sentido quando o
# projeto aceitar uma mensalidade, e a restricao travada e custo zero.
# PUBLISHER_AGGREGATOR=1
#
# Automacao de navegador. **Nasce desligada por decisao, nao por falta de
# configuracao** (ADR-010). A punicao por deteccao nao e erro HTTP tratavel: e
# shadowban ou perda da conta, e num projeto de cortes a conta e o ativo. Nem
# ligando isto ela entra na cascata automatica -- `resolve()` so aceita driver
# de risco zero. Ligar aqui apenas torna alcancavel o caminho explicito.
# PUBLISHER_BROWSER=1

# --- Driver youtube-api (Fase 3, bloco 3.4) --------------------------------
# Publica no SEU canal pela API oficial: de graca, sem risco de conta, **6
# uploads por dia** (1600 unidades por videos.insert contra 10.000/dia). O 7o
# do dia cai na fila manual sozinho, em vez de virar um job vermelho.
#
# O token de renovacao so nasce de um consentimento no navegador. Rode uma vez:
#
#   python youtube_oauth.py
#
# Ele abre a tela do Google, guarda o segredo em
# data/vault/youtube/<handle>.json com permissao 0600 e imprime estas tres
# linhas, caso voce prefira ambiente a arquivo:
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
#
# Antes disso, no console do Google Cloud: criar projeto, habilitar a YouTube
# Data API v3 e criar um ID de cliente OAuth do tipo "Aplicativo de computador".
#
# Se voce conseguiu aumento de quota, diga aqui -- o contador usa este numero:
# YOUTUBE_QUOTA_DAILY=10000
#
# Categoria do video (22 = People & Blogs):
# YOUTUBE_CATEGORY_ID=22
#
# Um app OAuth que ainda nao passou pela verificacao do Google sobe video
# trancado em privado. Nao da para saber isso antes de tentar, entao se for o
# seu caso diga aqui e o painel para de oferecer "publico":
# YOUTUBE_APP_UNVERIFIED=1

# --- Cofre de credenciais (secao 7: "aponta pra um cofre") -----------------
# `accounts.credentials_ref` guarda um endereco (`vault://local/youtube/canal`),
# nunca o token. Dois backends, os dois sem banco:
#   vault://env/<plataforma>/<handle>    as variaveis acima
#   vault://local/<plataforma>/<handle>  $DATA_DIR/vault/<plataforma>/<h>.json
# O `local` nasce com permissao 0600 e e o que o youtube_oauth.py grava.

# --- Auth (Fase 4, bloco 4.1) ----------------------------------------------
# **Nao ha flag.** A auth liga quando algum usuario ganha senha: abra o painel
# e a tela pede um e-mail e uma senha para o dono. Isso NAO cria conta nova --
# da senha ao usuario que o seed ja criou e que ja e dono dos seus projetos.
#
# Enquanto ninguem tiver senha, a ferramenta atende sem login, que e como ela
# sempre funcionou. **Nao exponha a instalacao a internet antes de definir o
# dono.**
#
# Chave que assina os tokens de sessao. Sem ela, um arquivo em
# $DATA_DIR/.session_secret com permissao 0600, criado sozinho. Defina aqui se
# o DATA_DIR nao for gravavel ou se houver mais de uma instancia sem volume
# compartilhado -- um segredo por instancia deslogaria a cada troca.
# SESSION_SECRET=

# --- Agendador (Fase 4, bloco 4.4, ADR-007) --------------------------------
# Publica os cortes sozinho, espalhados no dia. Os numeros sao PADRAO, nao
# verdade: calibrar horario de publicacao exige retencao medida, que e a
# tabela `metrics` e a Fase 5. Por isso estao aqui -- calibrar nao pode exigir
# deploy.
#
# Quantos por dia. Tres e a conta do §1; o teto duro e 6, da quota do YouTube,
# e o agendador nunca o ultrapassa.
# SCHEDULE_PER_DAY=3
#
# As horas do dia (local do servidor). Precisam caber no espacamento minimo.
# SCHEDULE_WINDOWS=11,15,19
#
# Espacamento minimo entre dois posts, em minutos.
# SCHEDULE_MIN_GAP_MINUTES=180
#
# Variacao aleatoria em torno da hora cheia, em minutos (±). **Pedir 0 nao
# desliga**: cai no piso de 5 min, com uma linha no log. Horario exato todo dia
# e um dos sinais que a deteccao de automacao cruza (ADR-007), e um agendador
# que aceita zero e um agendador que um dia roda com zero.
# SCHEDULE_JITTER_MINUTES=25

# --- Coletor de metricas (Fase 5) ------------------------------------------
# A tabela `metrics` e a que permite trocar a rubrica do LLM por retencao
# MEDIDA. Ela so enche se voce emitir a credencial de LEITURA, uma vez:
#
#   python youtube_oauth.py --leitura
#
# **O token de publicacao nao serve, e nao serve de proposito.** Ele tem escopo
# `youtube.upload` e so ele -- se vazar, a diferenca para o escopo completo e a
# diferenca entre um video indesejado e um canal vazio. A credencial de leitura
# e outra, com escopos `readonly`, guardada noutro arquivo: a que publica nao
# le, a que le nao publica, e nenhuma das duas apaga.
#
# De quanto em quanto tempo medir. Seis horas por padrao: retencao matura em
# dias, entao medir de hora em hora so gasta quota para gravar o mesmo numero.
# METRICS_TICK_SECONDS=21600
#
# Atraso do primeiro tique depois do boot, para que um container que reinicia
# varias vezes num deploy nao meca tudo a cada reinicio.
# METRICS_FIRST_TICK_SECONDS=300
