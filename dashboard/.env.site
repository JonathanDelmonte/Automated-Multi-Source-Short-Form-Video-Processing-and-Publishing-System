# Build do site publicado no Cloudflare (`npm run build:site`, 24-set-2026).
#
# O site e so a tela: quem baixa e processa e o programa no computador de quem
# o abre, e ele atende em localhost. Por isso os enderecos sao fixos e nao
# mudam de computador para computador: cada navegador fala com a propria
# maquina. O Chrome pede uma vez a permissao de "acessar apps e servicos neste
# dispositivo".
#
# Dois motores possiveis, procurados nesta ordem: o do Docker (8000) e o do
# ajudante (8001). Ver src/config.js.
#
# Fora deste modo nada muda: o painel do Docker (localhost:5175) continua com
# caminho relativo, que o proxy do Vite leva ao backend.
VITE_API_URLS=http://localhost:8000,http://localhost:8001
